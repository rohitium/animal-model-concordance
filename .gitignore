data/raw/fulltext/

# Secrets - never commit
.env
.env.*
!.env.example

# v0.4 reference-data snapshots (FDA, ClinicalTrials.gov/AACT); large, re-downloadable
data/raw/snapshots/

# Site builds are generated in CI from the committed data, never committed.
site/_build/
site/v04_build/

# v0.4 working data is large (~1 GB: LLM cache, retrieval frames, PDFs text layers) and
# regenerable. Ignore all of it, then allow back exactly the files the site build and the
# audit trail need, so the published site stays reproducible from the repo alone.
data/v04/**
